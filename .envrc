# direnv configuration for automatic environment loading
# Install direnv: https://direnv.net/

# Try to use flakes first (if nix flakes is available)
if has nix && nix flake show &>/dev/null; then
  echo "Loading Nix flake environment..."
  use flake
# Fall back to shell.nix
elif has nix && [ -f shell.nix ]; then
  echo "Loading shell.nix environment..."
  use nix
else
  echo "⚠️  Nix not found. Using system Node.js"
  
  # Load Node.js from system if available
  if has node; then
    layout node
  fi
fi

# Load .env file if it exists
if [ -f .env ]; then
  dotenv
else
  echo "⚠️  No .env file found. Copy .env.example to .env to set up environment variables."
fi

# Add node_modules/.bin to PATH for local packages
PATH_add node_modules/.bin

# Set development environment
export NODE_ENV=development

# Increase memory for Node.js processes
export NODE_OPTIONS="--max-old-space-size=4096"

# Custom project commands
watch_tests() {
  npm test -- --watchAll
}

serve_build() {
  npm run build && npx serve -s build
}